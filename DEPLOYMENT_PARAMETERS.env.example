# ===================================================================
# PARAMETRES ADMINISTRATEUR - DEPLOIEMENT PRODUCTION
# ===================================================================
# But: ce fichier contient toutes les valeurs a adapter par l'admin.
# Utilisation:
#   1) Copier ce fichier vers .env a la racine du projet.
#   2) Remplacer toutes les valeurs CHANGE_ME_*.
#   3) Lancer: bash docker/deploy.sh
#
# Important:
# - Ne jamais commiter le fichier .env dans Git.
# - Garder les secrets uniquement sur le serveur de production.

# ---------- Identite serveur / domaine ----------
DOMAIN_NAME=app.example.com
SERVER_IP=203.0.113.10

# ---------- Base de donnees PostgreSQL ----------
POSTGRES_DB=conges_db
POSTGRES_USER=conges_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# ---------- Session / auth ----------
AUTH_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_MIN_32_CHARS
AUTH_SESSION_TTL_HOURS=12
AUTH_GOOGLE_ONLY=true
AUTH_ADMIN_PASSWORD_HASH=CHANGE_ME_ADMIN_PASSWORD_HASH
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID.apps.googleusercontent.com
RH_AUTO_REJECT_DAYS=7
# false par défaut; true expose publiquement /docs et /docs-json via Nginx.
ENABLE_SWAGGER=false

# ---------- Reseau API / front ----------
# CORS_ORIGINS doit contenir le domaine public de l'application.
# Vous pouvez ajouter d'autres origines separees par des virgules.
CORS_ORIGINS=https://app.example.com,http://app.example.com,http://203.0.113.10
FRONTEND_URL=https://app.example.com

# URL API injectee au build frontend Docker.
# Par defaut, /api/v1 fonctionne avec le reverse proxy Nginx.
VITE_API_URL=/api/v1

# Si true, les migrations Prisma sont appliquees au demarrage backend.
RUN_PRISMA_MIGRATIONS=true

# ---------- Publication des ports Docker ----------
# Mode recommande sans conflit:
# publication en 8080/8443 (ports libres le plus souvent)
NGINX_BIND_ADDRESS=0.0.0.0
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# Mode alternatif (serveur dedie Docker seulement):
# NGINX_BIND_ADDRESS=0.0.0.0
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# ENABLE_HTTPS=true

# ---------- Email SMTP ----------
# EMAIL_MODE: off | dev | live | prod
EMAIL_MODE=prod
MAIL_HOST=smtp-relay.gmail.com
MAIL_PORT=465
MAIL_USER=conges@upowa.org
# Optionnel: laisser vide pour un SMTP relay sans authentification.
MAIL_PASS=
MAIL_AUTH=false
MAIL_FROM=Conges <conges@upowa.org>
DEV_EMAIL_RECIPIENT=

# ---------- HTTPS via conteneur certbot ----------
# false = HTTP seulement (ou HTTPS gere ailleurs)
# true  = certbot en conteneur (necessite port 80 public)
ENABLE_HTTPS=false
